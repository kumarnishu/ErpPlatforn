# Local development only. Replace with values from your identity provider for real use.
Authentication__Audience=ErpPlatform
Authentication__Issuer=ErpPlatform.Local
Authentication__SigningKey=local-development-only-signing-key-change-before-deploy

# PostgreSQL connection for the Platform API and EF Core migrations.
# Docker Compose uses these values to initialize PostgreSQL and connect Platform API.
POSTGRES_DB=erp_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
# For APIs running directly on your machine, use Host=localhost and the same credentials.
# ConnectionStrings__PlatformDatabase=Host=localhost;Port=5432;Database=erp_platform;Username=postgres;Password=postgres
# Tenant databases are created automatically by Todos API on each tenant's first request.
ConnectionStrings__TenantDatabaseAdmin=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres
# For local API processes, point both Platform and Todos APIs at the same Redis instance.
ConnectionStrings__Redis=localhost:6379
